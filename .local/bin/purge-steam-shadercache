#!/usr/bin/env bash
set -euo pipefail

cache_dir='/home/deck/.local/share/Steam/steamapps/shadercache'

if [[ ! -d "$cache_dir" || "$cache_dir" != '/home/deck/.local/share/Steam/steamapps/shadercache' ]]; then
    printf 'Refusing to purge unexpected path: %s\n' "$cache_dir" >&2
    exit 1
fi

find "$cache_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
