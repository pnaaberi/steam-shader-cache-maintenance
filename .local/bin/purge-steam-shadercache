#!/usr/bin/env bash
set -euo pipefail

user_home=${HOME:-}
cache_dir="$user_home/.local/share/Steam/steamapps/shadercache"

if [[ -z "$user_home" || "$user_home" != /* || ! -d "$cache_dir" || "$cache_dir" != "$user_home/.local/share/Steam/steamapps/shadercache" ]]; then
    printf 'Refusing to purge unexpected path: %s\n' "$cache_dir" >&2
    exit 1
fi

find "$cache_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
